      <path fill="#000080" d="M3 6h6v1H3zM3 8h6v1H3zM3 10h4v1H3z"/>
    </symbol>
    <symbol id="i-mail" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <path fill="#000" d="M1 3h14v10H1z"/><path fill="#fff" d="M2 4h12v8H2z"/><path fill="#808080" d="M2 4h1v1h1v1h1v1h1v1h4V7h1V6h1V5h1V4h1v1h-1v1h-1v1h-1v1h-1v1H6V8H5V7H4V6H3V5H2z"/>
    </symbol>
