      <path fill="#000080" d="M5 6h6v1H5zM5 8h6v1H5zM5 10h6v1H5zM5 12h4v1H5z"/>
    </symbol>
    <symbol id="i-app" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <path fill="#000" d="M1 2h14v12H1z"/><path fill="#c0c0c0" d="M2 5h12v8H2z"/><path fill="#000080" d="M2 3h12v2H2z"/><path fill="#fff" d="M3 6h10v6H3z"/>
      <path fill="#008080" d="M4 7h3v4H4z"/><path fill="#808080" d="M8 7h4v1H8zM8 9h4v1H8z"/>
    </symbol>
    <symbol id="i-gear" viewBox="0 0 16 16" shape-rendering="crispEdges">
