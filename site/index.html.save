    <symbol id="g-min" viewBox="0 0 8 7" shape-rendering="crispEdges"><path d="M1 5h6v2H1z"/></symbol>
    <symbol id="g-max" viewBox="0 0 9 9" shape-rendering="crispEdges"><path d="M0 0h9v9H0zM1 2v6h7V2z"/></symbol>
    <symbol id="g-restore" viewBox="0 0 9 9" shape-rendering="crispEdges"><path d="M2 0h7v6H8V2H2zM0 3h7v6H0zM1 5v3h5V5z"/></symbol>
    <symbol id="g-close" viewBox="0 0 8 7" shape-rendering="crispEdges"><path d="M0 0h2v1h1v1h2V1h1V0h2v1H7v1H6v1H5v1h1v1h1v1h1v1H6V6H5V5H3v1H2v1H0V6h1V5h1V4h1V3H2V2H1V1H0z"/></symbol>
