      <path fill="#fff" d="M6 3h2v1H6zM5 4h1v2H5z"/><path fill="#808080" d="M5 11h6v1H5zM5 13h6v1H5z"/><path fill="#000" d="M6 12h4v1H6zM6 14h4v1H6z"/>
    </symbol>
