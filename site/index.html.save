      <path fill="#c0c0c0" d="M7 2h2v2h2v1h1v2h2v2h-2v2h-1v1H9v2H7v-2H5v-1H4V9H2V7h2V5h1V4h2z"/><path fill="#000" d="M6 6h4v4H6z"/><path fill="#808080" d="M7 7h2v2H7z"/>
    </symbol>
