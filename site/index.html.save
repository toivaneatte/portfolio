      <path fill="#1084d0" d="M4 3h8v2H4z"/><path fill="#808080" d="M6 11h4v2H6z"/><path fill="#000" d="M3 13h10v2H3z"/><path fill="#c0c0c0" d="M4 13h8v1H4z"/>
