  <a class="skip" href="#projektit"><span lang="fi">Siirry projekteihin</span><span lang="en">Skip to projects</span></a>

  <main class="desktop">

    <!-- Tervetuloa-ikkuna -->
    <section id="tervetuloa" class="window win-welcome" data-window aria-label="Atte Toivanen">
      <div class="titlebar">
        <svg class="ico" aria-hidden="true"><use href="#i-computer"/></svg>
        <p class="title"><span lang="fi">Tervetuloa</span><span lang="en">Welcome</span></p>
        <div class="controls">
          <button class="ctl" type="button" data-action="min"><svg aria-hidden="true"><use href="#g-min"/></svg><span class="vh"><span lang="fi">Pienennä</span><span lang="en">Minimise</span></span></button>
          <button class="ctl" type="button" data-action="max"><svg aria-hidden="true"><use href="#g-max"/></svg><span class="vh"><span lang="fi">Suurenna</span><span lang="en">Maximise</span></span></button>
          <button class="ctl ctl-close" type="button" data-action="close"><svg aria-hidden="true"><use href="#g-close"/></svg><span class="vh"><span lang="fi">Sulje</span><span lang="en">Close</span></span></button>
        </div>
      </div>
      <div class="window-body welcome">
        <div class="welcome-main">
          <h1>Atte Toivanen</h1>
          <p class="lede">
            <span lang="fi">Tietojenkäsittelytieteiden neljännen vuoden opiskelija Tampereen yliopistosta. Kirjoitan ohjelmistoja C++:lla, ja Pythonilla, ylläpidän omaa Linux-palvelinta ja teen kandidaatintutkielmaa kyberturvallisuudesta.</span>
            <span lang="en">Third-year Computer Science student at Tampere University. I write software in C++, Python and TypeScript, run my own Linux server and am writing my bachelor’s thesis on cybersecurity.</span>
          </p>
          <div class="tip">
            <svg class="ico ico-lg" aria-hidden="true"><use href="#i-bulb"/></svg>
            <div>
              <p class="tip-head"><span lang="fi">Tiesitkö?</span><span lang="en">Did you know?</span></p>
              <p class="looking">
                <span lang="fi">Etsin kesätyö- tai harjoittelupaikkaa ohjelmistokehityksestä, palvelinympäristöistä tai tietoturvasta.</span>
                <span lang="en">I’m looking for a summer job or internship in software development, infrastructure or security.</span>
              </p>
            </div>
          </div>
        </div>
        <div class="welcome-actions">
          <a class="btn btn-default" href="#projektit" data-open="projektit"><span lang="fi">Projektit</span><span lang="en">Projects</span></a>
          <a class="btn" href="#yhteys" data-open="yhteys"><span lang="fi">Yhteystiedot</span><span lang="en">Contact</span></a>
          <button class="btn" type="button" data-lang-toggle><span lang="fi">In English</span><span lang="en">Suomeksi</span></button>
        </div>
      </div>
    </section>

    <!-- Komentokehote: miten sivu kulki lukijalle -->
    <section id="reitti" class="window win-dos" data-window aria-labelledby="route-title">
      <div class="titlebar">
        <svg class="ico" aria-hidden="true"><use href="#i-dos"/></svg>
        <h2 id="route-title" class="title">
          <span lang="fi">Näin tämä sivu tuli luoksesi</span>
          <span lang="en">How this page reached you</span>
        </h2>
        <div class="controls">
          <button class="ctl" type="button" data-action="min"><svg aria-hidden="true"><use href="#g-min"/></svg><span class="vh"><span lang="fi">Pienennä</span><span lang="en">Minimise</span></span></button>
          <button class="ctl" type="button" data-action="max"><svg aria-hidden="true"><use href="#g-max"/></svg><span class="vh"><span lang="fi">Suurenna</span><span lang="en">Maximise</span></span></button>
          <button class="ctl ctl-close" type="button" data-action="close"><svg aria-hidden="true"><use href="#g-close"/></svg><span class="vh"><span lang="fi">Sulje</span><span lang="en">Close</span></span></button>
        </div>
      </div>
      <div class="window-body">
        <div class="term" id="term">
          <p class="term-line prompt" aria-hidden="true">C:\&gt;tracert atte.toivanen</p>
          <ol class="hops">
            <li class="term-line hop">
              <span class="hop-name"><span lang="fi">Selaimesi</span><span lang="en">Your browser</span></span>
              <span class="hop-detail">HTTPS</span>
            </li>
            <li class="term-line hop">
              <span class="hop-name">Cloudflare</span>
              <span class="hop-detail"><span lang="fi">TLS ja välimuisti</span><span lang="en">TLS and caching</span></span>
            </li>
            <li class="term-line hop">
              <span class="hop-name"><span lang="fi">Salattu tunneli</span><span lang="en">Encrypted tunnel</span></span>
              <span class="hop-detail"><span lang="fi">ei avattuja portteja</span><span lang="en">no open ports</span></span>
            </li>
            <li class="term-line hop hop-home">
              <span class="hop-name"><span lang="fi">Kotiserveri, Tampere</span><span lang="en">Home server, Tampere</span></span>
              <span class="hop-detail">Ubuntu Server, nginx</span>
            </li>
          </ol>
          <p class="term-line" aria-hidden="true"><span lang="fi">Reitti valmis.</span><span lang="en">Trace complete.</span></p>

          <div class="term-block" id="server-status" hidden>
            <p class="term-line prompt" aria-hidden="true">C:\&gt;uptime</p>
            <p class="term-line">
              <span lang="fi">Serveri on ollut päällä <strong data-uptime></strong>.</span>
              <span lang="en">The server has been up for <strong data-uptime></strong>.</span>
            </p>
            <p class="term-line backup-line" hidden>
              <span lang="fi">Viimeisin automaattinen varmuuskopio onnistui <strong data-backup></strong>.</span>
              <span lang="en">The last automatic backup succeeded <strong data-backup></strong>.</span>
            </p>
          </div>

          <p class="term-line prompt" aria-hidden="true">C:\&gt;type <span lang="fi">LUEMINUT.TXT</span><span lang="en">README.TXT</span></p>
          <p class="term-line">
            <span lang="fi">Palvelin on vanha kannettava, jolle olen rakentanut mediapalvelimen, mainosten eston, salatut varmuuskopiot ja valvonnan. Tämä sivu on yksi sen palveluista.</span>
            <span lang="en">The server is an old laptop that I’ve turned into a media server with network-wide ad blocking, encrypted backups and monitoring. This page is one of its services.</span>
          </p>
          <p class="term-line prompt" aria-hidden="true">C:\&gt;<span class="cursor"></span></p>
        </div>
      </div>
    </section>

    <!-- Projektit: resurssienhallinta -->
    <section id="projektit" class="window win-projects" data-window aria-labelledby="projects-title">
      <div class="titlebar">
        <svg class="ico" aria-hidden="true"><use href="#i-folder"/></svg>
        <h2 id="projects-title" class="title"><span lang="fi">Projektit</span><span lang="en">Projects</span></h2>
        <div class="controls">
          <button class="ctl" type="button" data-action="min"><svg aria-hidden="true"><use href="#g-min"/></svg><span class="vh"><span lang="fi">Pienennä</span><span lang="en">Minimise</span></span></button>
          <button class="ctl" type="button" data-action="max"><svg aria-hidden="true"><use href="#g-max"/></svg><span class="vh"><span lang="fi">Suurenna</span><span lang="en">Maximise</span></span></button>
          <button class="ctl ctl-close" type="button" data-action="close"><svg aria-hidden="true"><use href="#g-close"/></svg><span class="vh"><span lang="fi">Sulje</span><span lang="en">Close</span></span></button>
        </div>
      </div>
      <div class="window-body">
        <div class="address" aria-hidden="true">
          <span class="address-label"><span lang="fi">Osoite</span><span lang="en">Address</span></span>
          <span class="field address-field"><svg class="ico" aria-hidden="true"><use href="#i-folder"/></svg>C:\Atte\<span lang="fi">Projektit</span><span lang="en">Projects</span></span>
        </div>

        <div class="pane">
          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-computer"/></svg>
              <div>
                <h3><span lang="fi">Kotiserveri</span><span lang="en">Home server</span></h3>
                <p class="meta"><span lang="fi">Oma projekti, 2026</span><span lang="en">Personal project, 2026</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Muutin vanhan kannettavan Ubuntu-palvelimeksi, joka pyörittää mediapalvelinta, kuvien varmuuskopiointia ja omia sovelluksiani. Hallintapaneelit näkyvät vain WireGuard-pohjaisen VPN:n kautta, palomuuri rajaa kotiverkon pääsyn ja SSH toimii vain avaimilla. Kotiverkossa erilaisia houkuttimia, joiden hälytykset tulevat puhelimeen itse kirjoittamani käsittelijän kautta.</span>
                <span lang="en">I turned an old laptop into an Ubuntu server that runs a media server, photo backup and my own applications. Admin interfaces are reachable only through a WireGuard-based VPN, a firewall limits home-network access and SSH accepts keys only. A honeypot watches the home network and sends alerts to my phone through a handler I wrote.</span>
              </p>
              <p>
                <span lang="fi">Kirjoitin Bash-skriptit, jotka varmuuskopioivat asetukset ja tietokannat salattuina pilveen joka yö ja tarkistavat palvelut kahden minuutin välein. Hälytys lähtee vain tilan muuttuessa, jotta ilmoituksiin voi luottaa.</span>
                <span lang="en">I wrote Bash scripts that back up configuration and databases, encrypted, to cloud storage every night and check the services every two minutes. Alerts fire only on state changes so that notifications stay trustworthy.</span>
              </p>
              <ul class="tags">
                <li>Linux</li><li>Docker</li><li>Bash</li><li>Python</li><li>Tailscale</li><li>UFW</li><li>restic</li><li>AdGuard Home</li><li>OpenCanary</li><li>Cloudflare Tunnel</li>
              </ul>
            </div>
          </article>

          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-app"/></svg>
              <div>
                <h3>Salitreeni</h3>
                <p class="meta"><span lang="fi">Oma projekti, 2026</span><span lang="en">Personal project, 2026</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Treenipäiväkirja, jota käytän omissa salitreeneissäni. C++20-taustapalvelu tarjoaa REST-rajapinnan ja tallentaa sarjat SQLiteen. Puhelimen kotinäytölle asennettava käyttöliittymä näyttää edellisen kerran tulokset, tunnistaa ennätykset heti sarjan kirjauksessa ja piirtää kehityksen kuvaajiksi ilman ulkoisia kirjastoja.</span>
                <span lang="en">A workout log I use for my own gym training. A C++20 backend serves a REST API and stores sets in SQLite. The installable phone interface shows last session’s results, detects personal records as soon as a set is logged and draws progress charts without external libraries.</span>
              </p>
              <ul class="tags">
                <li>C++20</li><li>SQLite</li><li>REST</li><li>JavaScript</li><li>PWA</li>
              </ul>
            </div>
          </article>

          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-app"/></svg>
              <div>
                <h3><span lang="fi">Tampereen pysäköintikartta</span><span lang="en">Tampere parking map</span></h3>
                <p class="meta"><span lang="fi">Ryhmätyö, Software Design, 2026</span><span lang="en">Group project, Software Design, 2026</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Karttasovellus, joka arvioi keskustan pysäköintialueiden käyttöastetta yhdistämällä Tampereen kaupungin, Digitrafficin ja Ilmatieteen laitoksen avointa dataa. Vastaan käyttöliittymän suunnittelusta ja toteutuksesta MVC-arkkitehtuurilla sekä osasta suunnitteludokumenttia.</span>
                <span lang="en">A map application that estimates city-centre parking occupancy by combining open data from the City of Tampere, Digitraffic and the Finnish Meteorological Institute. I’m responsible for the UI design and its MVC implementation, and co-authored the design document.</span>
              </p>
              <ul class="tags">
                <li>C++</li><li>MVC</li><li>OpenStreetMap</li><li><span lang="fi">Avoin data</span><span lang="en">Open data</span></li>
              </ul>
            </div>
          </article>

          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-app"/></svg>
              <div>
                <h3>Tuulikartta</h3>
                <p class="meta"><span lang="fi">Ryhmätyö, software engineering project TUNI, 2026</span><span lang="en">Group project, software engineering project TUNI, 2026</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Suomen tuuli- ja sääkartta, johon integroitiin säteily-, kelikamera- ja geomagneettista dataa STUKin, Digitrafficin ja Ilmatieteen laitoksen rajapinnoista. </span>
                <span lang="en">A Finnish wind and weather map that integrates radiation, road-camera and geomagnetic data from STUK, Digitraffic and FMI APIs.</span>
              </p>
              <ul class="tags">
                <li>JavaScript</li><li>Leaflet</li><li>PHP</li><li>Docker</li><li>GitHub Actions</li><li>AlmaLinux</li>
              </ul>
            </div>
          </article>

          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-folder"/></svg>
              <div>
                <h3>Pistoke</h3>
                <p class="meta"><span lang="fi">Oma projekti, kehitteillä</span><span lang="en">Personal project, in progress</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Sähköautojen latauksen hintavertailu koko Suomeen. Tavoitteena on näyttää kartalla lähimmät ja edullisimmat latausasemat samaan tapaan kuin polttoaineiden hintavertailupalvelut tekevät.</span>
                <span lang="en">A charging price comparison for electric vehicles across Finland. The goal is to show the nearest and cheapest charging stations on a map, the way fuel price comparison services do for petrol.</span>
              </p>
              <ul class="tags">
                <li>React</li><li>TypeScript</li><li>Vite</li>
              </ul>
            </div>
          </article>

          <article class="project">
            <header class="project-head">
              <svg class="ico ico-lg" aria-hidden="true"><use href="#i-doc"/></svg>
              <div>
                <h3><span lang="fi">Ajoneuvorekisterin dataputki</span><span lang="en">Vehicle registry data pipeline</span></h3>
                <p class="meta"><span lang="fi">Kurssityö, data-analytiikka</span><span lang="en">Coursework, data analytics</span></p>
              </div>
            </header>
            <div class="project-body">
              <p>
                <span lang="fi">Python-putki, joka käsittelee Traficomin avoimen ajoneuvodatan SQLite-tietokantaan ja visualisoi sen Metabasessa Docker-ympäristössä.</span>
                <span lang="en">A Python pipeline that processes Traficom’s open vehicle registration data into SQLite and visualises it in Metabase, running in Docker.</span>
              </p>
              <ul class="tags">
                <li>Python</li><li>SQLite</li><li>Metabase</li><li>Docker</li>
              </ul>
            </div>
          </article>
        </div>

        <div class="statusbar" aria-hidden="true">
          <span class="field"><span lang="fi">6 objektia</span><span lang="en">6 objects</span></span>
          <span class="field field-grow"><span lang="fi">Omat projektit ja ryhmätyöt</span><span lang="en">Personal and group projects</span></span>
        </div>
      </div>
    </section>

    <!-- Kandidaatintutkielma: asiakirja -->
    <section id="tutkielma" class="window win-thesis" data-window aria-labelledby="thesis-title">
      <div class="titlebar">
        <svg class="ico" aria-hidden="true"><use href="#i-doc"/></svg>
        <h2 id="thesis-title" class="title"><span lang="fi">Kandidaatintutkielma</span><span lang="en">Bachelor’s thesis</span></h2>
        <div class="controls">
          <button class="ctl" type="button" data-action="min"><svg aria-hidden="true"><use href="#g-min"/></svg><span class="vh"><span lang="fi">Pienennä</span><span lang="en">Minimise</span></span></button>
          <button class="ctl" type="button" data-action="max"><svg aria-hidden="true"><use href="#g-max"/></svg><span class="vh"><span lang="fi">Suurenna</span><span lang="en">Maximise</span></span></button>
          <button class="ctl ctl-close" type="button" data-action="close"><svg aria-hidden="true"><use href="#g-close"/></svg><span class="vh"><span lang="fi">Sulje</span><span lang="en">Close</span></span></button>
        </div>
      </div>
      <div class="window-body">
        <div class="pane page-surround">
          <div class="page">
            <p class="thesis-title" lang="fi">DDoS-hyökkäykset Venäjän ja Ukrainan sodassa: tekniikat, kohteet ja vaikutukset</p>
            <p class="thesis-translation"><span lang="en">DDoS attacks in the Russia–Ukraine war: techniques, targets and impact</span></p>
            <p>
              <span lang="fi">Tutkin vertaisarvioitujen lähteiden pohjalta, millaisia hyökkäystyyppejä ja työkaluja sodan yhteydessä on käytetty vuodesta 2014 lähtien, mihin hyökkäykset ovat kohdistuneet ja millaisia vaikutuksia niillä on ollut.</span>
              <span lang="en">Based on peer-reviewed research, I study which attack types and tools have been used in connection with the war since 2014, what they have targeted and what impact they have had. Written in Finnish.</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Osaaminen: ominaisuudet-ikkuna -->
